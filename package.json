{
  "name": "triasicbrowser",
  "version": "0.1.1",
  "description": "Triasic — A modern custom browser built on Electron",
  "main": "out/main/index.js",
  "author": "Triasic",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.1",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
